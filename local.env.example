# Machine settings for the study scripts. Copy to local.env (git-ignored) and edit; every scripts/study-*.sh,
# scripts/first-hour.sh and scripts/arith_lib.py read it if it exists. A value set here replaces an environment variable of the same name.

# Lock file that serialises GPU jobs. Point it at the same file as other GPU programs on the machine so that their
# jobs and the study's never time the card at the same time. Default: runs/gpu.lock in this repository.
#STUDY_GPU_LOCK=/path/to/gpu.lock

# Folder holding the llama.cpp builds (llama.cpp-latest, llama.cpp-latest-patched) and ppl-text.txt, for the LLM study.
#LLM_BUILD_ROOT=/path/to/build

# Folder holding the GGUF models of the LLM study. Default: LLM_BUILD_ROOT/../models.
#LLM_MODELS=/path/to/models

# A checkout of the RDNA 3 companion repository (rdna3-fp8), used by scripts/first-hour.sh for its llama.cpp builds,
# models and the loop_isa.py listing tool. Default: $HOME/Projects/rdna3-fp8.
#RDNA3_DIR=/path/to/rdna3-fp8

# Path of an upscaler's log file inside the game folder, read by scripts/study-home.sh (optional).
#STUDY_UPSCALER_LOG=bin/x64/path/to/upscaler.log

# What the upscaler log reader (scripts/study-home.sh upscaler, and game --upscaler) matches in that log. All optional;
# the defaults are neutral names that fit no real upscaler, so set them to the literals of the upscaler's own log.
# The two models print different stage names in their timing lines; the reader tells them apart by these lists
# (the stage names of a timing line, numbers left out, joined with ", "). Default 1: exposure, input, network, output;
# default 2: stage1, stage2, stage3, stage4.
#STUDY_UPSCALER_STAGES_1="exposure, input, network, output"
#STUDY_UPSCALER_STAGES_2="stage1, stage2, stage3, stage4"
# The names printed for the two models. Default: 1 and 2.
#STUDY_UPSCALER_LABEL_1=1
#STUDY_UPSCALER_LABEL_2=2
# The settings key of the log's "settings: <key>=..." line; such a line after a timing line opens a new session.
# Default: model.
#STUDY_UPSCALER_MODEL_KEY=model
# The tag the log's "network kernels:" line carries when the upscaler's self-check passed; "<tag>(unchecked)" means the
# check did not run. Default: selfcheck.
#STUDY_UPSCALER_CHECK_TAG=selfcheck

# ROCm 10.1 is found through ROCM_PATH in the environment (default $HOME/.local/opt/rocm), not through this file.
