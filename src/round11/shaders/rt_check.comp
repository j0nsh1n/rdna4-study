#version 460
// Round 11 item 1, control: one ray per entry of a ray buffer (origin, tmin, direction, tmax from the CPU); the answer is the
// committed hit distance (or -1 for a miss) and the primitive and instance indices. The CPU brute force must agree.
#extension GL_GOOGLE_include_directive : require
#include "rt_common.glsl"
layout(local_size_x = 64) in;
layout(set = 0, binding = 1) readonly buffer Rays { vec4 ray[]; };   // 2 vec4 per ray: (ox,oy,oz,tmin), (dx,dy,dz,tmax)
layout(set = 0, binding = 2) writeonly buffer Res { vec4 res[]; };   // (t or -1, primitive, instance, 0)
layout(push_constant) uniform PC { uint nrays; uint first_hit; } pc;
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.nrays) return;
    vec4 a = ray[2u * i], b = ray[2u * i + 1u];
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT | (pc.first_hit != 0u ? gl_RayFlagsTerminateOnFirstHitEXT : 0u), 0xFF, a.xyz, a.w, b.xyz, b.w);
    while (rayQueryProceedEXT(rq)) { }
    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        res[i] = vec4(-1.0, -1.0, -1.0, 0.0);
    } else {
        res[i] = vec4(rayQueryGetIntersectionTEXT(rq, true), float(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true)),
                      float(rayQueryGetIntersectionInstanceIdEXT(rq, true)), 1.0);
    }
}
