#version 460
// Round 11 item 1, rate cells: every invocation traces `rpt` independent rays straight down (-z) from z = 1 onto a scene in
// the plane z = 0, with a ray query (the traversal loop is in the shader; the box and triangle tests are the ray accelerator's).
// Scene kinds: 0 = S1 grid cells (lower-left half-cell triangle per cell, nx x ny cells, `ncell` of them present),
//              1 = S2 sliver slab (rays over the square [0, ext]^2), 2 = S3 instances (same lattice as kind 0).
// The ray position lies on a lattice of 1/16 cell, offset by 1/64, so a hit is decided by integer arithmetic (see r11_rt_ref.h).
// Per-ray cost is the loop: init, proceed until done, read the committed state. No result of one ray feeds the next.
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
#include "rt_common.glsl"
layout(local_size_x = 64) in;
layout(set = 0, binding = 1) buffer Out {
    uvec4 hits_total;      // x: rays that hit (summed over the dispatch), y: rays traced low 32, z, w: spare
    uvec4 timing;          // x,y: cycles lo/hi of invocation 0, z: realtime ticks, w: invocation 0's hits
};
layout(push_constant) uniform PC {
    uint nx, ny, ncell;    // cells across, cells down, cells present
    uint rpt;              // rays per invocation
    uint flags;            // bit 0: terminate on first hit, bit 1: shuffled ray order (else coherent: consecutive ids are neighbours)
    uint seed;
    float tmax;
    uint kind;
    float ext;             // kind 1: side of the ray square
    uint total_rays;       // rays in one pass (the shuffle permutes ids inside it)
} pc;

void main() {
    const uint gid = gl_GlobalInvocationID.x;
    const uint nthreads = gl_NumWorkGroups.x * 64u;
    uint64_t c0 = clockARB();
    uint64_t r0 = clockRealtimeEXT();
    uint myhits = 0;
    for (uint k = 0; k < pc.rpt; ++k) {
        uint id = (k * nthreads + gid) % pc.total_rays;  // adjacent lanes get adjacent ids: coherent order walks neighbouring cells
        if ((pc.flags & 2u) != 0u) id = hash32(id ^ pc.seed) % pc.total_rays;  // shuffled: neighbouring ids go to unrelated cells
        // lattice position of the ray: the cell and the 1/16-cell sub-position, from two hashes of the id
        float ox, oy;
        if (pc.kind == 1u) {
            ox = float(hash32(id * 2u + 1u + pc.seed) & 0xffffu) * (pc.ext / 65536.0);
            oy = float(hash32(id * 2u + 2u + pc.seed) & 0xffffu) * (pc.ext / 65536.0);
        } else if ((pc.flags & 2u) != 0u) {
            uint hx = hash32(id * 2u + 1u + pc.seed), hy = hash32(id * 2u + 2u + pc.seed);
            uint cx = (hx >> 4) % pc.nx, cy = (hy >> 4) % pc.ny;
            ox = float(cx) + float((hx & 15u) * 4u + 1u) * (1.0 / 64.0);   // (a + 1/4) / 16
            oy = float(cy) + float((hy & 15u) * 4u + 1u) * (1.0 / 64.0);
        } else {
            // coherent: ids walk the cells in row order, then the 16 x 16 sub-positions
            uint cell = id % pc.ncell;
            uint sub = (id / pc.ncell) & 255u;
            ox = float(cell % pc.nx) + float((sub & 15u) * 4u + 1u) * (1.0 / 64.0);
            oy = float(cell / pc.nx) + float((sub >> 4) * 4u + 1u) * (1.0 / 64.0);
        }
        rayQueryEXT rq;
        const uint rflags = (pc.flags & 1u) != 0u ? gl_RayFlagsTerminateOnFirstHitEXT : gl_RayFlagsOpaqueEXT;
        rayQueryInitializeEXT(rq, tlas, rflags | gl_RayFlagsOpaqueEXT, 0xFF, vec3(ox, oy, 1.0), 0.0, vec3(0.0, 0.0, -1.0), pc.tmax);
        while (rayQueryProceedEXT(rq)) { }
        if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) myhits++;
    }
    const uint w = subgroupAdd(myhits);
    if (gl_SubgroupInvocationID == 0u) atomicAdd(hits_total.x, w);
    if (gid == 0u) {
        uint64_t c1 = clockARB();
        uint64_t r1 = clockRealtimeEXT();
        uint64_t dc = c1 - c0;
        timing = uvec4(uint(dc), uint(dc >> 32), uint(r1 - r0), myhits);
    }
}
