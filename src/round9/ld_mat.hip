// Round 9, item A: a stream of FP8 matrix instructions fed by global loads: cost per matrix instruction against the
// lookahead D, the memory level the loads come from, and the waves per SIMD (set by padding the kernel's registers).
//
// Usage: ld_mat <card|one> --r <51|90|167|209> [--levels L0,L2,MALL,GDDR] [--ds ref,0,1,2,4,8,all] [--bursts 3]
//               [--ms 50] [--aim LEVEL]
//   The instruction streams are in ld_mat_blocks.h (generated by scripts/round9/gen_ld_mat.py, which documents them):
//   NMM v_wmma_f32_16x16x16_fp8_fp8 per iteration (114 rounded up to a multiple of the register ring, so the ring does not
//   wrap onto live registers), one b64 load per lane before each, its address masked into the level's span, issued D matrix
//   instructions ahead of use (s_wait_loadcnt D), written order enforced by inline assembly. ref = the same without loads.
//   card  64 work-groups (one per CU) of 64 x W threads (W = 16, 16, 9, 7 waves per SIMD for R = 51, 90, 167, 209),
//         bursts of --ms milliseconds (50 to 100), each started with the hotspot below 58 C (raised from 50 C on 2026-11-24 after a cell was refused at 53 C following the preceding burst; the calibration launches before the bursts are not checked), --bursts of them per cell.
//         Every wave records its placement (HW_ID1, shader engine message) and its counter window; a burst counts only if
//         128 SIMDs have W waves each ("placed 1"). Cost = per SIMD, (latest end - earliest start) in the SIMD's cycle
//         counter / (W x iterations x NMM): cycles per matrix instruction per SIMD (8.0 is the matrix unit's own rate).
//   one   one wave on one SIMD, the same streams, 3 launches per cell, the in-kernel counter.
//   Levels (buffer span the loads wander over; each wave starts at a different phase, a golden-ratio sequence, so the
//   waves are spread over the span): L0 8 KiB (all waves of a CU reuse it), L2 1 MiB, MALL 32 MiB (memory-side cache,
//   above the 8 MB L2, below 64 MB), GDDR 1 GiB.
//   --aim LEVEL: the deliberate break of control (d): the loads go to the span of LEVEL while the cell keeps its
//   label; the analysis requires the D = 0 cost to move.
//   Each cell is calibrated (iterations for --ms), warmed by the calibration launches, then timed.
// Output: RESULT ld_mat burst ..., RESULT ld_mat cell ..., CLOCKS, THERMAL lines.
#include "../study/tim_common.h"
#include "ld_mat_blocks.h"

#include <atomic>
#include <cstring>
#include <map>
#include <string>
#include <thread>

namespace {

struct Rec {
    uint32_t pl, t0, t1, pad;
    uint64_t rt0, rt1;
};

#define LDM_KERNEL(NAME, D, K, R, TPB, NMM, TEXT)                                                                      \
    __global__ __launch_bounds__(TPB) void k_##NAME(const char * base, uint32_t n_iter, uint32_t log2span, int nact, \
                                                    int only0, Rec * out) {                                          \
        __shared__ int cnt[2];                                                                                       \
        if (threadIdx.x < 2) {                                                                                       \
            cnt[threadIdx.x] = 0;                                                                                    \
        }                                                                                                            \
        __syncthreads();                                                                                             \
        const uint32_t pl = mem::placement();                                                                        \
        const int simd = (pl >> 10) & 1;                                                                             \
        int rank = 0;                                                                                                \
        if ((threadIdx.x % 32) == 0) {                                                                               \
            rank = atomicAdd(&cnt[simd], 1);                                                                         \
        }                                                                                                            \
        rank = __builtin_amdgcn_readfirstlane(rank);                                                                 \
        __syncthreads();                                                                                             \
        if ((only0 && simd != 0) || rank >= nact) {                                                                  \
            return;                                                                                                  \
        }                                                                                                            \
        const uint32_t wave = blockIdx.x * (TPB / 32) + threadIdx.x / 32;                                            \
        uint32_t voff = (((wave * 0x9E3779B9u) >> (32 - log2span)) & ~255u) + (threadIdx.x % 32) * 8u;             \
        const uint32_t mask = (1u << log2span) - 1u;                                                                 \
        uint32_t t0, t1, c, atmp;                                                                                      \
        const uint64_t rt0 = mem::realtime();                                                                        \
        asm volatile(TEXT : [t0] "=&s"(t0), [t1] "=&s"(t1), [cnt] "=&s"(c), [voff] "+v"(voff), [atmp] "=&v"(atmp)      \
                     : [n] "s"(n_iter), [base] "s"(base), [mask] "s"(mask)                                           \
                     : LDM_CLOB_##NAME);                                                                             \
        const uint64_t rt1 = mem::realtime();                                                                        \
        if ((threadIdx.x % 32) == 0) {                                                                               \
            out[wave] = Rec{pl, t0, t1, 0, rt0, rt1};                                                                \
        }                                                                                                            \
    }
LD_MAT_BLOCKS(LDM_KERNEL)

using Kern = void (*)(const char *, uint32_t, uint32_t, int, int, Rec *);
struct Cell {
    const char * name;
    int D, K, R, TPB, NMM;
    Kern k;
};
#define LDM_ROW(NAME, D, K, R, TPB, NMM, TEXT) {#NAME, D, K, R, TPB, NMM, k_##NAME},
const Cell cells[] = {LD_MAT_BLOCKS(LDM_ROW)};

struct Level {
    const char * name;
    uint32_t log2span;
};
const Level levels[] = {{"L0", 13}, {"L2", 20}, {"MALL", 25}, {"GDDR", 30}};

const Level * find_level(const std::string & n) {
    for (const Level & l : levels) {
        if (n == l.name) {
            return &l;
        }
    }
    return nullptr;
}

char * g_buf = nullptr;
Rec * g_rec = nullptr;
constexpr int GROUPS = 64;
constexpr int MAX_RECS = GROUPS * 32;

// the cell of this register count and lookahead label: "ref", "all" or a number
const Cell * find_cell(int R, const std::string & d) {
    int want = -2;
    if (d == "ref") {
        want = -1;
    } else if (d != "all") {
        want = std::atoi(d.c_str());
    }
    const Cell * best = nullptr;
    for (const Cell & c : cells) {
        if (c.R != R) {
            continue;
        }
        if (d == "all") {
            if (c.D >= 0 && (!best || c.D > best->D)) {
                best = &c;  // the largest lookahead of this register count
            }
        } else if (c.D == want) {
            return &c;
        }
    }
    return best;
}

std::atomic<bool> g_run{false};
struct Guard {
    std::thread th;
    double tmax = 0;
    void start() {
        g_run = true;
        tmax = 0;
        th = std::thread([this] {
            while (g_run) {
                const double t = mem::hotspot_c();
                if (t >= 0) {
                    tmax = std::max(tmax, t);
                    if (t >= 95.0) {
                        std::printf("THERMAL hotspot %.0f C is at or above 95 C: stopping at once\n", t);
                        std::fflush(stdout);
                        std::_Exit(4);
                    }
                }
                std::this_thread::sleep_for(std::chrono::milliseconds(20));
            }
        });
    }
    void stop() {
        g_run = false;
        th.join();
    }
};

// idle until the hotspot is below `limit`; false if not within 120 s
bool cool_below(double limit, double & t) {
    const auto t0 = std::chrono::steady_clock::now();
    while ((t = mem::hotspot_c()) >= limit) {
        if (t >= 95.0 || std::chrono::steady_clock::now() - t0 > std::chrono::seconds(120)) {
            return false;
        }
        std::this_thread::sleep_for(std::chrono::milliseconds(250));
    }
    return true;
}

double med(std::vector<double> v) {
    if (v.empty()) {
        return NAN;
    }
    std::sort(v.begin(), v.end());
    return v[v.size() / 2];
}

struct Run {
    bool card;
    const Cell * c;
    uint32_t log2span;
};

double launch_ms(const Run & r, uint32_t n_iter) {
    hipEvent_t e0, e1;
    CHECK(hipEventCreate(&e0));
    CHECK(hipEventCreate(&e1));
    const int groups = r.card ? GROUPS : 1;
    const int nact = r.card ? r.c->TPB / 64 : 1;
    CHECK(hipMemset(g_rec, 0, sizeof(Rec) * MAX_RECS));
    CHECK(hipEventRecord(e0));
    hipLaunchKernelGGL(r.c->k, dim3(groups), dim3(r.c->TPB), 0, 0, (const char *) g_buf, n_iter, r.log2span, nact,
                       r.card ? 0 : 1, g_rec);
    CHECK(hipGetLastError());
    CHECK(hipEventRecord(e1));
    CHECK(hipEventSynchronize(e1));
    float ms = 0;
    CHECK(hipEventElapsedTime(&ms, e0, e1));
    CHECK(hipEventDestroy(e0));
    CHECK(hipEventDestroy(e1));
    return ms;
}

struct Result {
    bool placed = false;
    size_t simds = 0;
    double cyc_med = NAN, cyc_min = NAN, cyc_max = NAN, clock_ghz = NAN, ms = 0;
};

// per SIMD: the span from the earliest wave start to the latest wave end in that SIMD's own cycle counter, divided by
// the matrix instructions its waves issued
Result analyse(const Run & r, uint32_t iters, double ms) {
    Result o;
    o.ms = ms;
    std::vector<Rec> rec(MAX_RECS);
    CHECK(hipMemcpy(rec.data(), g_rec, sizeof(Rec) * MAX_RECS, hipMemcpyDeviceToHost));
    struct Sd {
        int n = 0;
        uint32_t t0min = 0;
        uint32_t span = 0;
        uint64_t rt_lo = ~0ull, rt_hi = 0;
        bool have = false;
    };
    std::map<uint32_t, Sd> per;
    for (const Rec & x : rec) {
        if (x.rt1 > x.rt0) {
            Sd & d = per[mem::pl_simd(x.pl)];
            ++d.n;
            if (!d.have || (int32_t) (x.t0 - d.t0min) < 0) {
                d.t0min = x.t0;
                d.have = true;
            }
            d.rt_lo = std::min(d.rt_lo, x.rt0);
            d.rt_hi = std::max(d.rt_hi, x.rt1);
        }
    }
    for (const Rec & x : rec) {
        if (x.rt1 > x.rt0) {
            Sd & d = per[mem::pl_simd(x.pl)];
            d.span = std::max(d.span, (uint32_t) (x.t1 - d.t0min));
        }
    }
    const int W = r.card ? r.c->TPB / 64 : 1;
    o.simds = per.size();
    o.placed = r.card ? per.size() == 128 : per.size() == 1;
    std::vector<double> cyc, clk;
    for (auto & kv : per) {
        o.placed = o.placed && kv.second.n == W;
        cyc.push_back((double) kv.second.span / ((double) kv.second.n * iters * r.c->NMM));
        clk.push_back((double) kv.second.span / ((double) (kv.second.rt_hi - kv.second.rt_lo) / 1e8) / 1e9);
    }
    if (!cyc.empty()) {
        o.cyc_med = med(cyc);
        o.cyc_min = *std::min_element(cyc.begin(), cyc.end());
        o.cyc_max = *std::max_element(cyc.begin(), cyc.end());
        o.clock_ghz = med(clk);
    }
    return o;
}

uint32_t calibrate(const Run & r, double target_ms) {
    const uint32_t n1 = r.card ? 16 : 256, n2 = r.card ? 64 : 2048;
    launch_ms(r, n1);  // code load, first touches
    const double t1 = launch_ms(r, n1), t2 = launch_ms(r, n2);
    double per = (t2 - t1) / (n2 - n1);
    if (!(per > 0)) {
        per = t2 / n2;
    }
    const double n = std::min(std::max(target_ms / per, 32.0), 5e7);
    return (uint32_t) n;
}

}  // namespace

int main(int argc, char ** argv) {
    require_arch();
    if (argc < 3 || (std::strcmp(argv[1], "card") != 0 && std::strcmp(argv[1], "one") != 0)) {
        std::fprintf(stderr, "usage: ld_mat <card|one> --r R [--levels ..] [--ds ..] [--bursts N] [--ms MS] [--aim LEVEL]\n");
        return 2;
    }
    const bool card = std::strcmp(argv[1], "card") == 0;
    int R = 0, bursts = 3;
    double ms_target = 50;
    std::string lv = "L0,L2,MALL,GDDR", ds = "ref,0,1,2,4,8,all", aim;
    for (int i = 2; i + 1 < argc; i += 2) {
        const std::string k = argv[i];
        if (k == "--r") R = std::atoi(argv[i + 1]);
        else if (k == "--levels") lv = argv[i + 1];
        else if (k == "--ds") ds = argv[i + 1];
        else if (k == "--bursts") bursts = std::atoi(argv[i + 1]);
        else if (k == "--ms") ms_target = std::atof(argv[i + 1]);
        else if (k == "--aim") aim = argv[i + 1];
        else {
            std::fprintf(stderr, "unknown option %s\n", k.c_str());
            return 2;
        }
    }
    if (ms_target > 200 || bursts < 1 || bursts > 10) {
        std::fprintf(stderr, "bad arguments (bursts of at most 200 ms, 1 to 10 bursts)\n");
        return 2;
    }
    const size_t alloc = (1ull << 30) + (64u << 10);
    CHECK(hipMalloc(&g_buf, alloc));
    CHECK(hipMemset(g_buf, 0x24, alloc));
    CHECK(hipMalloc(&g_rec, sizeof(Rec) * MAX_RECS));
    mem::clocks("start");
    auto split = [](const std::string & s) {
        std::vector<std::string> v;
        size_t a = 0;
        while (a <= s.size()) {
            const size_t b = s.find(',', a);
            v.push_back(s.substr(a, b == std::string::npos ? std::string::npos : b - a));
            if (b == std::string::npos) break;
            a = b + 1;
        }
        return v;
    };
    bool ref_done = false;
    int refused = 0;
    for (const std::string & ln : split(lv)) {
        const Level * lvl = find_level(ln);
        if (!lvl) {
            std::fprintf(stderr, "unknown level %s\n", ln.c_str());
            return 2;
        }
        const Level * aimed = aim.empty() ? lvl : find_level(aim);
        if (!aimed) {
            std::fprintf(stderr, "unknown --aim level %s\n", aim.c_str());
            return 2;
        }
        for (const std::string & d : split(ds)) {
            if (d == "ref" && ref_done) {
                continue;
            }
            const Cell * c = find_cell(R, d);
            if (!c) {
                std::fprintf(stderr, "no kernel for R %d D %s\n", R, d.c_str());
                return 2;
            }
            const bool is_ref = c->D < 0;
            ref_done |= is_ref;
            const Run run{card, c, aimed->log2span};
            const uint32_t iters = calibrate(run, ms_target);
            std::vector<double> med_cyc;
            for (int b = 0; b < bursts; ++b) {
                double t0c = 0;
                if (!cool_below(card ? 58.0 : 60.0, t0c)) {
                    std::printf("NOT STARTED: hotspot %.0f C after 120 s of cool-down\n", t0c);
                    std::fflush(stdout);
                    return 7;
                }
                Guard g;
                g.start();
                const double ms = launch_ms(run, iters);
                g.stop();
                const Result o = analyse(run, iters, ms);
                refused += !o.placed;
                if (o.placed) {
                    med_cyc.push_back(o.cyc_med);
                }
                std::printf("RESULT ld_mat burst mode %s R %d W %d level %s aimed %s D %s dval %d kernel %s rep %d iters %u "
                            "ms %.2f cyc_per_mm_med %.3f min %.3f max %.3f clock_ghz %.3f placed %d simds %zu hot_start %.0f "
                            "hot_max %.0f\n",
                            card ? "card" : "one", R, card ? c->TPB / 64 : 1, is_ref ? "-" : lvl->name, is_ref ? "-" : aimed->name,
                            d.c_str(), c->D, c->name, b, iters, o.ms, o.cyc_med, o.cyc_min, o.cyc_max, o.clock_ghz, (int) o.placed,
                            o.simds, t0c, g.tmax);
                std::fflush(stdout);
            }
            std::printf("RESULT ld_mat cell mode %s R %d level %s aimed %s D %s dval %d cyc_per_mm_median_of_bursts %.3f bursts_placed %zu "
                        "of %d\n",
                        card ? "card" : "one", R, is_ref ? "-" : lvl->name, is_ref ? "-" : aimed->name, d.c_str(), c->D, med(med_cyc),
                        med_cyc.size(), bursts);
            std::fflush(stdout);
        }
    }
    mem::clocks("end");
    mem::report_hottest();
    return refused ? 1 : 0;
}
