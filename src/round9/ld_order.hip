// Round 9, item B: does s_wait_loadcnt N retire loads in order? (miss then hit, partial waits, mixed counters)
//
// Usage: ld_order run [--only NAME]
//   One wave (32 lanes), the cycle counter read inside the kernel. Each pattern of ld_order_blocks.h (generated by
//   scripts/round9/gen_ld_order.py, the single source of the instruction text) is one inline-assembly statement:
//     prelude (untimed): every destination register is set to a sentinel, the near line is loaded (an L0 hit for the
//       pattern) and the near scalar line is loaded (a scalar-cache hit);
//     pattern: loads and waits as written, with the cycle counter read after each T; at each T the destination
//       registers are copied to snapshot registers (after the read, so the copy is not timed);
//     drain: s_wait_loadcnt 0, s_wait_dscnt 0, s_wait_kmcnt 0.
//   "far" loads read a line that nothing has read since the cache flush (GDDR6): a fresh 256 KiB-spaced address per
//   repetition, a 512 MiB random read kernel before each launch (the method of mem_inflight.hip), repetition 0 dropped
//   (instruction cache). Cost = counter at the snapshot minus the counter at the start of the pattern, minus the
//   baseline pattern `empty` (two counter reads back to back): the differential method.
//   Early return shows as a wrong word: after the wait, a register that must hold its data is compared with the
//   expected word (a ramp: word i of the buffer holds i). The number of lanes that match is reported per snapshot and
//   register. Patterns named brk_* wait the wrong counter on purpose and claim the global register is valid.
// Output lines: RESULT ld_order <name> reps N c1 median min max [c2 ...] ok1 <7 counts> ok2 <7 counts> must1 .. stale1 ..
#include "../study/tim_common.h"
#include "ld_order_blocks.h"

#include <cstring>
#include <map>
#include <string>

namespace {

constexpr int REPS = 21;       // repetition 0 is dropped
constexpr int LAUNCHES = 3;    // a flush before each
constexpr uint32_t SENT = 0xdeadbeefu;
constexpr uint32_t NEAR_OFF = 0;               // byte offsets in the 1 GiB ramp buffer
constexpr uint32_t SNEAR_OFF = 4096;           // near scalar line
constexpr uint32_t FAR_BASE = 64u << 20;       // far region: fresh lines from here on
constexpr uint32_t REP_STRIDE = 256u << 10;    // a fresh far line per repetition
constexpr uint32_t LAUNCH_STRIDE = 16u << 20;  // and per launch
constexpr uint32_t SFAR_ADD = 128u << 10;      // the far scalar line sits this far from the far vector line

struct Rec {
    uint32_t c[2];
    uint8_t ok[2][8];
};

#define LDO_CLOB                                                                                                    \
    "v40", "v41", "v42", "v43", "v44", "v45", "v50", "s48", "s50", "memory"

#define LDO_KERNEL(NAME, NSNAP, KINDS, M1, S1, M2, S2, TEXT)                                                         \
    __global__ __launch_bounds__(32) void k_##NAME(const char * buf, uint32_t far_off, Rec * out) {                  \
        extern __shared__ uint32_t lds[];                                                                            \
        lds[threadIdx.x] = 0x1000u + threadIdx.x;                                                                    \
        __syncthreads();                                                                                             \
        const uint32_t lane = threadIdx.x;                                                                           \
        uint32_t la = lane * 4;                                                                                      \
        uint32_t vnear = NEAR_OFF + lane * 4;                                                                        \
        for (int rep = 0; rep < REPS; ++rep) {                                                                       \
            const uint32_t foff = far_off + (uint32_t) rep * REP_STRIDE;                                             \
            uint32_t vfar = foff + lane * 4;                                                                         \
            const char * fbase = buf;                                                                                \
            const char * nbase = buf;                                                                                \
            const char * sn = buf + SNEAR_OFF;                                                                       \
            const char * sf = buf + foff + SFAR_ADD;                                                                 \
            uint32_t t0, t1, t2;                                                                                     \
            uint32_t a0, a1, a2, a3, a4, a5, a6, b0, b1, b2, b3, b4, b5, b6;                                        \
            asm volatile(                                                                                            \
                "v_mov_b32 v40, 0xdeadbeef\n v_mov_b32 v41, 0xdeadbeef\n v_mov_b32 v42, 0xdeadbeef\n"                \
                "v_mov_b32 v43, 0xdeadbeef\n v_mov_b32 v44, 0xdeadbeef\n v_mov_b32 v45, 0xdeadbeef\n"                \
                "s_mov_b32 s48, 0xdeadbeef\n"                                                                        \
                "global_load_b32 v50, v62, %[nbase]\n s_load_b32 s50, %[sn], 0x0\n"                                   \
                "s_wait_loadcnt 0\n s_wait_kmcnt 0\n"                                                                \
                "s_getreg_b32 %[t0], hwreg(HW_REG_SHADER_CYCLES_LO)\n" TEXT                                           \
                "s_wait_loadcnt 0\n s_wait_dscnt 0\n s_wait_kmcnt 0\n"                                               \
                : [t0] "=&s"(t0), [t1] "=&s"(t1), [t2] "=&s"(t2), "=&{v64}"(a0), "=&{v65}"(a1), "=&{v66}"(a2),     \
                  "=&{v67}"(a3), "=&{v68}"(a4), "=&{v69}"(a5), "=&{v70}"(a6), "=&{v72}"(b0), "=&{v73}"(b1),         \
                  "=&{v74}"(b2), "=&{v75}"(b3), "=&{v76}"(b4), "=&{v77}"(b5), "=&{v78}"(b6)                          \
                : [fbase] "s"(fbase), [nbase] "s"(nbase), [sn] "s"(sn), [sf] "s"(sf), "{v60}"(vfar), "{v62}"(vnear), \
                  "{v63}"(la)                                                                                        \
                : LDO_CLOB);                                                                                         \
            if (rep > 0) {                                                                                           \
                const char * kinds = KINDS;                                                                          \
                Rec r;                                                                                               \
                r.c[0] = t1 - t0;                                                                                    \
                r.c[1] = NSNAP > 1 ? t2 - t0 : 0;                                                                    \
                const uint32_t av[2][7] = {{a0, a1, a2, a3, a4, a5, a6}, {b0, b1, b2, b3, b4, b5, b6}};              \
                for (int s = 0; s < 2; ++s) {                                                                        \
                    int m = 0;                                                                                       \
                    for (int i = 0; i < 7; ++i) {                                                                    \
                        uint32_t want = 0;                                                                           \
                        switch (kinds[i]) {                                                                          \
                            case 'M': want = (foff + (uint32_t) m * 16384u + lane * 4u) / 4u; ++m; break;            \
                            case 'H': want = (NEAR_OFF + lane * 4u) / 4u; break;                                    \
                            case 'L': want = 0x1000u + lane; break;                                                  \
                            case 'S': want = SNEAR_OFF / 4u; break;                                                  \
                            case 'F': want = (foff + SFAR_ADD) / 4u; break;                                          \
                            default: break;                                                                          \
                        }                                                                                            \
                        const bool match = kinds[i] != '-' && av[s][i] == want;                                      \
                        r.ok[s][i] = (uint8_t) __builtin_popcountll(__ballot(match));                                \
                    }                                                                                                \
                    r.ok[s][7] = 0;                                                                                  \
                }                                                                                                    \
                if (lane == 0) {                                                                                     \
                    out[rep - 1] = r;                                                                                \
                }                                                                                                    \
            }                                                                                                        \
        }                                                                                                            \
    }
LD_ORDER_PATTERNS(LDO_KERNEL)

using Kern = void (*)(const char *, uint32_t, Rec *);
struct Pat {
    const char * name;
    Kern k;
    int nsnap;
    const char * kinds;
    uint32_t must[2], stale[2];
};
#define LDO_ROW(NAME, NSNAP, KINDS, M1, S1, M2, S2, TEXT) {#NAME, k_##NAME, NSNAP, KINDS, {M1, M2}, {S1, S2}},
const Pat pats[] = {LD_ORDER_PATTERNS(LDO_ROW)};

char * g_buf = nullptr;
char * g_flush = nullptr;
unsigned * g_sink = nullptr;
Rec * g_out = nullptr;

__global__ void k_ramp(uint32_t * p, size_t n) {
    for (size_t i = blockIdx.x * (size_t) blockDim.x + threadIdx.x; i < n; i += (size_t) gridDim.x * blockDim.x) {
        p[i] = (uint32_t) i;
    }
}

typedef unsigned u4 __attribute__((ext_vector_type(4)));
__global__ void k_flush(const u4 * p, uint32_t n, unsigned * sink) {
    unsigned acc = 0;
    for (uint32_t i = blockIdx.x * blockDim.x + threadIdx.x; i < n; i += gridDim.x * blockDim.x) {
        acc += p[i].x;
    }
    sink[blockIdx.x * blockDim.x + threadIdx.x] = acc;
}

void do_flush() {
    hipLaunchKernelGGL(k_flush, dim3(512), dim3(256), 0, 0, (const u4 *) g_flush, (512u << 20) / 16, g_sink);
    CHECK(hipGetLastError());
    CHECK(hipDeviceSynchronize());
}

}  // namespace

int main(int argc, char ** argv) {
    require_arch();
    if (argc < 2 || std::strcmp(argv[1], "run") != 0) {
        std::fprintf(stderr, "usage: ld_order run [--only NAME]\n");
        return 2;
    }
    const char * only = nullptr;
    for (int i = 2; i + 1 < argc; ++i) {
        if (std::strcmp(argv[i], "--only") == 0) {
            only = argv[i + 1];
        }
    }
    CHECK(hipMalloc(&g_buf, 1ull << 30));
    hipLaunchKernelGGL(k_ramp, dim3(4096), dim3(256), 0, 0, (uint32_t *) g_buf, (size_t) (1ull << 28));
    CHECK(hipGetLastError());
    CHECK(hipDeviceSynchronize());
    CHECK(hipMalloc(&g_flush, 512u << 20));
    mem::fill(g_flush, 512u << 20, mem::RANDOM);
    CHECK(hipMalloc(&g_sink, 512 * 256 * 4));
    CHECK(hipMalloc(&g_out, sizeof(Rec) * REPS));
    mem::clocks("start");
    double base1 = 0;
    for (const Pat & p : pats) {
        if (only && std::strcmp(only, p.name) != 0 && std::strcmp(p.name, "empty") != 0) {
            continue;
        }
        mem::cool_down();
        std::vector<double> c1, c2;
        uint64_t ok[2][8] = {};
        size_t n = 0;
        for (int l = 0; l < LAUNCHES; ++l) {
            do_flush();
            hipLaunchKernelGGL(p.k, dim3(1), dim3(32), 4096, 0, (const char *) g_buf, FAR_BASE + (uint32_t) l * LAUNCH_STRIDE,
                               g_out);
            CHECK(hipGetLastError());
            CHECK(hipDeviceSynchronize());
            std::vector<Rec> h(REPS - 1);
            CHECK(hipMemcpy(h.data(), g_out, sizeof(Rec) * (REPS - 1), hipMemcpyDeviceToHost));
            for (const Rec & r : h) {
                c1.push_back(r.c[0]);
                c2.push_back(r.c[1]);
                for (int s = 0; s < 2; ++s) {
                    for (int i = 0; i < 7; ++i) {
                        ok[s][i] += r.ok[s][i];
                    }
                }
                ++n;
            }
        }
        const tim::Clean m1 = tim::clean_of(c1), m2 = tim::clean_of(c2);
        if (std::strcmp(p.name, "empty") == 0) {
            base1 = m1.med;
        }
        std::printf("RESULT ld_order %s reps %zu c1 %.1f %.1f %.1f c2 %.1f %.1f %.1f dropped %zu base %.1f nsnap %d kinds %s ",
                    p.name, n, m1.med, m1.lo, m1.hi, m2.med, m2.lo, m2.hi, m1.dropped, base1, p.nsnap, p.kinds);
        for (int s = 0; s < 2; ++s) {
            std::printf("ok%d", s + 1);
            for (int i = 0; i < 7; ++i) {
                std::printf(" %llu", (unsigned long long) ok[s][i]);
            }
            std::printf(" must%d %u stale%d %u ", s + 1, p.must[s], s + 1, p.stale[s]);
        }
        std::printf("lanes_per_check %zu\n", n * 32);
        std::fflush(stdout);
    }
    mem::clocks("end");
    mem::report_hottest();
    return 0;
}
