#version 450
// Round 9: pushes everything else out of L2 and the memory-side cache by reading a large buffer once.
layout(local_size_x_id = 0) in;
layout(set = 0, binding = 0) buffer Ev { uvec4 ev[]; };
layout(set = 0, binding = 2) buffer Sink { uint sink[]; };
layout(push_constant) uniform PC {
    uint n, stride;
} pc;
void main() {
    uint acc = 0u;
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += pc.stride) {
        uvec4 v = ev[i];
        acc ^= v.x ^ v.y ^ v.z ^ v.w;
    }
    if (acc == 0x9e3779b9u) sink[gl_LocalInvocationID.x] = acc;
}
