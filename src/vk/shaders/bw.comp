#version 450
// Item 3a: read bandwidth. Each lane sums 16-byte loads, 4 in flight, over a grid-stride walk of the buffer.
#include "common.glsl"
layout(push_constant) uniform PC {
    uint n_vec4; // multiple of 4 x total lanes
} pc;
layout(set = 0, binding = 0) readonly buffer In { uvec4 data[]; };
layout(set = 0, binding = 2) buffer Part { uint part[]; };

void main() {
    uint total = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    uint i = gl_GlobalInvocationID.x;
    uvec4 s = uvec4(0);
    for (; i < pc.n_vec4; i += 4u * total) {
        uvec4 v0 = data[i];
        uvec4 v1 = data[i + total];
        uvec4 v2 = data[i + 2u * total];
        uvec4 v3 = data[i + 3u * total];
        s += v0 + v1 + v2 + v3;
    }
    uint t = subgroupAdd(s.x + s.y + s.z + s.w);
    if (subgroupElect()) atomicAdd(part[gl_WorkGroupID.x & 1023u], t);
}
