#version 450
// Item 6: one FP16 x FP16 + FP32 multiply-add per set (workgroup = one subgroup), all matrices row-major, stride 16.
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x_id = 0) in;
layout(set = 0, binding = 0) buffer D { float d[]; };
layout(set = 0, binding = 1) readonly buffer C { float cin[]; };
layout(set = 0, binding = 2) readonly buffer A { float16_t a[]; };
layout(set = 0, binding = 3) readonly buffer B { float16_t b[]; };
void main() {
    uint base = gl_WorkGroupID.x * 256u;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mb;
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> mc;
    coopMatLoad(ma, a, base, 16, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(mb, b, base, 16, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(mc, cin, base, 16, gl_CooperativeMatrixLayoutRowMajor);
    mc = coopMatMulAdd(ma, mb, mc);
    coopMatStore(mc, d, base, 16, gl_CooperativeMatrixLayoutRowMajor);
}
